{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "downhub",
  "main": "src/index.js",
  "compatibility_date": "2026-09-26",
  "containers": [
    {
      "class_name": "DownHubContainer",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DOWNHUB_CONTAINER",
        "class_name": "DownHubContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DownHubContainer"]
    }
  ]
}
